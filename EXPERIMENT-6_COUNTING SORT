#include <stdio.h>

void countingSort(int a[], int n) {
    int i, max = a[0];

    for (i = 1; i < n; i++)
        if (a[i] > max)
            max = a[i];

    int count[max + 1];

    for (i = 0; i <= max; i++)
        count[i] = 0;

    for (i = 0; i < n; i++)
        count[a[i]]++;

    int k = 0;
    for (i = 0; i <= max; i++) {
        while (count[i]--)
            a[k++] = i;
    }
}

int main() {
    int a[] = {4, 2, 2, 8, 3, 3, 1};
    int n = 7, i;

    countingSort(a, n);

    printf("Sorted array: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
