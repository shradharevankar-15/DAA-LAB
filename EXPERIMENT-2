#include <stdio.h>

int main() {
    int n, m;

    printf("Enter size of first array: ");
    scanf("%d", &n);

    int A[n];

    printf("Enter elements of first sorted array: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &A[i]);

    printf("Enter size of second array: ");
    scanf("%d", &m);

    int B[m];

    printf("Enter elements of second sorted array: ");
    for (int i = 0; i < m; i++)
        scanf("%d", &B[i]);

    int i = 0, j = 0;

    printf("\nUnion: ");

    while (i < n && j < m) {
        if (A[i] < B[j]) {
            printf("%d ", A[i]);
            i++;
        }
        else if (B[j] < A[i]) {
            printf("%d ", B[j]);
            j++;
        }
        else {
            printf("%d ", A[i]);
            i++;
            j++;
        }
    }

    while (i < n) {
        printf("%d ", A[i]);
        i++;
    }

    while (j < m) {
        printf("%d ", B[j]);
        j++;
    }

    i = 0;
    j = 0;

    printf("\nIntersection: ");

    while (i < n && j < m) {
        if (A[i] < B[j])
            i++;
        else if (B[j] < A[i])
            j++;
        else {
            printf("%d ", A[i]);
            i++;
            j++;
        }
    }

    return 0;
}
